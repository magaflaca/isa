  <!--
    IsaClient's texts: before compiling, the list of texts to translate (tools/l10n/en.json) is taken again from the
    code; IsaClient carries it (IsaClient.Assets/Languages/en.json) and counts the "% translated" of each language
    against it. The languages themselves are downloaded from github.com/magaflaca/isa-l10n; with that repository cloned
    next to IsaClient, its source and index are brought up to date too (publish: tools/l10n/publish_l10n.py). Only
    runs when a .cs file changed since the last time; a failure never stops the build.
    Turn it off with any of: the file tools/l10n/no-auto (empty is fine), -p:IsaL10nAuto=false, or the environment
    variable IsaL10nAuto=false. Off on CI (GitHub Actions), where the committed catalog is used as it is.
  -->
  <PropertyGroup>
    <IsaL10nDir>$(MSBuildProjectDirectory)\..\tools\l10n</IsaL10nDir>
    <IsaL10nAuto Condition="'$(IsaL10nAuto)' == '' And ('$(CI)' == 'true' Or Exists('$(IsaL10nDir)\no-auto'))">false</IsaL10nAuto>
    <IsaL10nAuto Condition="'$(IsaL10nAuto)' == ''">true</IsaL10nAuto>
  </PropertyGroup>
  <Target Name="IsaL10nCatalog" BeforeTargets="BeforeBuild" Condition="'$(IsaL10nAuto)' == 'true' And Exists('$(IsaL10nDir)\build_packs.py')" Inputs="@(Compile)" Outputs="$(IsaL10nDir)\en.json">
    <Message Importance="high" Text="IsaClient texts: updating the catalog and isa-l10n (turn off: tools/l10n/no-auto)" />
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)\..\tools\refactor&quot; -c Release -- extract-strings &quot;$(IsaL10nDir)\en.json&quot; &quot;$(IsaL10nDir)\context.json&quot;" WorkingDirectory="$(MSBuildProjectDirectory)\.." ContinueOnError="true" />
    <Exec Command="python &quot;$(IsaL10nDir)\build_packs.py&quot;" WorkingDirectory="$(MSBuildProjectDirectory)\.." ContinueOnError="true" />
  </Target>
  <Target Name="SetLargeAddressAware" AfterTargets="Build">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/../tools/set_laa.py&quot; &quot;$(TargetPath)&quot;" />
  </Target>
</Project>
+	public static void WriteAccessoryVisibility(BinaryWriter writer, bool[] hideVisibleAccessory)
+	{
+		ushort num = 0;
+		for (int i = 0; i < hideVisibleAccessory.Length; i++)
+		{
+			if (hideVisibleAccessory[i])
+			{
+				num |= (ushort)(1 << i);
+			}
+		}
+		writer.Write(num);
+	}
